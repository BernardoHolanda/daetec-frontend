{
  "name": "DAETEC Frontend",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "web",
  "workspaceFolder": "/app",
  "postCreateCommand": "npm install",
  "forwardPorts": [5173],
  "customizations": {
    "vscode": {
      "extensions": ["Vue.volar", "esbenp.prettier-vscode", "dbaeumer.vscode-eslint"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
